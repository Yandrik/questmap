{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI (backend)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/.venv/bin/fastapi",
            "python": "${workspaceFolder}/backend/.venv/bin/python",
            "args": [
                "dev", "main.py",
                "--host", "0.0.0.0",
                "--port", "8000"
            ],
            "envFile": "${workspaceFolder}/backend/.env",
            "cwd": "${workspaceFolder}/backend",
            "jinja": true,
            "justMyCode": true
        }
    ]
}
