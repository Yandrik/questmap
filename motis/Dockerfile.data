FROM ubuntu:24.04

ARG TARGETARCH=amd64
ARG MOTIS_VERSION=v2.10.2

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bzip2 \
    ca-certificates \
    curl \
    osmium-tool \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://github.com/motis-project/motis/releases/download/${MOTIS_VERSION}/motis-linux-${TARGETARCH}.tar.bz2" \
  | tar -xj -C / \
  && test -x /motis

COPY data/config.yml /opt/questmap/motis-config.yml
COPY scripts/prepare-data-volume.sh /usr/local/bin/prepare-motis-data

RUN chmod +x /usr/local/bin/prepare-motis-data \
  && mkdir -p /data /valhalla

CMD ["/usr/local/bin/prepare-motis-data"]
